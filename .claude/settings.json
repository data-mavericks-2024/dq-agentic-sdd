{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(uv:*)",
      "PowerShell(uvx:*)",
      "PowerShell(uv run pytest:*)",
      "PowerShell(uv run ruff:*)",
      "PowerShell(uv run mypy:*)",
      "PowerShell(uv run alembic:*)",
      "PowerShell(uv run uvicorn:*)",
      "PowerShell(uv run streamlit:*)",
      "PowerShell(pytest:*)",
      "PowerShell(ruff:*)",
      "PowerShell(mypy:*)",
      "PowerShell(alembic:*)",
      "PowerShell(uvicorn:*)",
      "PowerShell(streamlit:*)",
      "PowerShell(psql $env:DQ_READONLY_URL:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git show:*)",
      "PowerShell(.specify/scripts/powershell/:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run alembic:*)",
      "Bash(uv run uvicorn:*)",
      "Bash(uv run streamlit:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(alembic:*)",
      "Bash(uvicorn:*)",
      "Bash(streamlit:*)",
      "Bash(psql $DQ_READONLY_URL:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "PowerShell(.specify\\\\scripts\\\\powershell\\\\resolve-template.ps1 constitution-template -Json)",
      "PowerShell(.specify\\\\scripts\\\\powershell\\\\resolve-template.ps1 spec-template -Json)",
      "PowerShell(Get-ChildItem specs -Recurse -File | ForEach-Object { \"{0,8}  {1}\" -f $_.Length, $_.FullName.Replace\\(\"$PWD\\\\\",\"\"\\) }; \"--- feature.json ---\"; Get-Content .specify\\\\feature.json -Raw; \"--- branch ---\"; git rev-parse --abbrev-ref HEAD; \"--- uncommitted ---\"; git --no-pager status --short)",
      "PowerShell(.specify\\\\scripts\\\\powershell\\\\check-prerequisites.ps1 -Json -PathsOnly)",
      "PowerShell(.specify\\\\scripts\\\\powershell\\\\setup-plan.ps1 -Json)",
      "PowerShell(.specify\\\\scripts\\\\powershell\\\\setup-tasks.ps1 -Json)",
      "PowerShell(.specify\\\\scripts\\\\powershell\\\\check-prerequisites.ps1 -Json -RequireTasks -IncludeTasks)",
      "PowerShell($t = Get-Content specs\\\\001-data-foundation\\\\tasks.md; $ids = $t | Select-String -Pattern '^- \\\\[ \\\\] \\(T\\\\d+[a-z]?\\)' | ForEach-Object { $_.Matches[0].Groups[1].Value }; \"total tasks : $\\($ids.Count\\)\"; \"duplicate ids: $\\(\\($ids | Group-Object | Where-Object Count -gt 1\\).Name -join ', '\\)\"; $bad = $t | Select-String -Pattern '^- \\\\[ \\\\] ' | Where-Object { $_.Line -notmatch '^- \\\\[ \\\\] T\\\\d+[a-z]? ' }; \"malformed   : $\\($bad.Count\\)\"; $new = @\\('T031a','T033a','T035a','T049a','T055a','T055b','T066a'\\); \"new present : $\\(\\(\\($new | Where-Object { $ids -contains $_ }\\) -join ', '\\)\\)\")"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.dev)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "PowerShell(psql $env:DQ_PUBLISH_URL:*)",
      "PowerShell(psql $env:DQ_MIGRATE_URL:*)",
      "PowerShell(psql $env:DQ_SANDBOX_URL:*)",
      "Bash(psql $DQ_PUBLISH_URL:*)",
      "Bash(psql $DQ_MIGRATE_URL:*)",
      "Bash(psql $DQ_SANDBOX_URL:*)"
    ]
  }
}
