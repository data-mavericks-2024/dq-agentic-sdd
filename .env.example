# Copy to .env and fill in. .env is gitignored — never commit real values.
# Never paste a filled-in version of this file into a chat, an issue, or a PR.

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — single project (see docs/conversation.md, Session 2)
#
# Project: FDB   Region: ap-southeast-1 (Singapore)   Plan: Free
# The project ref is not a secret; the database password is.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=ogsxigcineqwhjxocqmp

# STATEFUL connection — Alembic, LangGraph PostgresSaver, and anything using
# prepared statements or advisory locks.
#
# Prefer the DIRECT connection:
#   postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# On free tier this is IPv6-only. If it times out, your network is IPv4-only —
# use the SESSION POOLER instead, which is IPv4 and holds one connection per
# client, so prepared statements and advisory locks still work:
#   postgresql://postgres.<ref>:<pw>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Do NOT put the transaction pooler (port 6543) here. It breaks both silently.
SUPABASE_DB_STATEFUL_URL=

# TRANSACTION POOLER — short read-only queries only. Port 6543.
#   postgresql://postgres.<ref>:<pw>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_POOLED_URL=

# ---------------------------------------------------------------------------
# Tests
#
# One project, so integration tests run against the SAME database as dev.
# Isolation is by schema: each session creates test_<uuid>, migrates into it,
# and drops it on teardown. A session-start sweep drops stale test_* schemas
# left behind by crashed runs.
#
# This URL must be the stateful one — migrations run per test session.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
TEST_SCHEMA_PREFIX=test_

# ---------------------------------------------------------------------------
# Schema prefix
#
# Empty in development. Set to test_<YYYYMMDDHHMMSS>_<uuid6>_ by the test
# harness, which is what isolates a test run on the one shared project.
#
# NON-EMPTY DISABLES THE ROLE BOOTSTRAP MIGRATION. Roles are cluster-global and
# cannot be schema-isolated, so a prefixed run must never create or drop them.
# ---------------------------------------------------------------------------
DQ_SCHEMA_PREFIX=

# ---------------------------------------------------------------------------
# Least-privilege role connections (constitution principle VI)
#
# Seven roles, same database, no role inheriting another. The list is
# exhaustive: an eighth role fails tests/integration/test_role_conformance.py
# until the constitution is amended.
#
# THESE DO NOT EXIST UNTIL T012 RUNS. The bootstrap migration in
# migrations/versions/0001_bootstrap_roles.py creates them, reading the
# passwords below. Sequence:
#
#   1. Fill DQ_*_PASSWORD (scripts/gen_role_passwords.py writes them for you)
#   2. Leave DQ_*_URL blank and run `uv run alembic upgrade head`
#      — the first upgrade connects as the Supabase superuser because
#        dq_migrate does not exist yet
#   3. Fill DQ_*_URL below; every later upgrade connects as dq_migrate
#
# Shape (session pooler, IPv4-safe):
#   postgresql://dq_engine.<ref>:<pw>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DQ_MIGRATE_URL=
DQ_INGEST_URL=
DQ_AUTHOR_URL=
DQ_ENGINE_URL=
DQ_READONLY_URL=
DQ_SANDBOX_URL=
DQ_PUBLISH_URL=

# ---------------------------------------------------------------------------
# Role passwords — read ONLY by the bootstrap migration, never by application
# code. Generate with:  uv run python scripts/gen_role_passwords.py
# That script writes them straight into .env and prints nothing.
# ---------------------------------------------------------------------------
MIGRATE_DQ_PASSWORD=
INGEST_DQ_PASSWORD=
AUTHOR_DQ_PASSWORD=
ENGINE_DQ_PASSWORD=
READONLY_DQ_PASSWORD=
SANDBOX_DQ_PASSWORD=
PUBLISH_DQ_PASSWORD=

# ---------------------------------------------------------------------------
# Deliberately absent: SUPABASE_SERVICE_ROLE_KEY.
# It bypasses every role boundary above. If application code needs it, that is
# a design error, not a missing variable.
# ---------------------------------------------------------------------------
