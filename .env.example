# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — DEV project
#
# Supabase exposes two connection strings per project. They are NOT
# interchangeable. Alembic, the LangGraph PostgresSaver, and anything using
# prepared statements or advisory locks REQUIRE the direct connection; the
# transaction-mode pooler silently breaks them.
#
# Direct : port 5432, host db.<ref>.supabase.co
# Pooled : port 6543, host aws-0-<region>.pooler.supabase.com
# ---------------------------------------------------------------------------
SUPABASE_DEV_DIRECT_URL=
SUPABASE_DEV_POOLED_URL=

# ---------------------------------------------------------------------------
# Supabase — TEST project (a separate project, not a schema inside dev)
# Integration tests create a uniquely named schema here, migrate into it, and
# drop it on teardown.
# ---------------------------------------------------------------------------
SUPABASE_TEST_DIRECT_URL=

# ---------------------------------------------------------------------------
# Least-privilege role connections (constitution principle 6)
# Same database, different roles. No role inherits another's privileges.
# ---------------------------------------------------------------------------
DQ_READONLY_URL=
DQ_SANDBOX_URL=
DQ_PUBLISH_URL=
DQ_MIGRATE_URL=

# ---------------------------------------------------------------------------
# Deliberately absent: SUPABASE_SERVICE_ROLE_KEY.
# It bypasses every role boundary above. If application code needs it, that is
# a design error, not a missing variable.
# ---------------------------------------------------------------------------
